{
  "name": "@exa-foh/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:management": "npm run build -w @exa-foh/shared && npm run build && node --test tests/management.test.mjs tests/business-management.test.mjs tests/guest-branding.test.mjs tests/mock-product-images.test.mjs tests/menu-preview.test.mjs"
  },
  "dependencies": {
    "@exa-foh/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "tsx": "^4.19.2"
  }
}
