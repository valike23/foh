{
  "name": "@exa-foh/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build --workspace @exa-foh/shared && tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:online": "tsx watch src/online-server.ts",
    "start:online": "node dist/online-server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:online": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@exa-foh/shared": "*",
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2"
  }
}
