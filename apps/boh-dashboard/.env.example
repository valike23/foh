# Tenant subdomains use the PostgreSQL-backed online API. localhost stays on-site.
ONLINE_INTERNAL_URL="http://127.0.0.1:4200"
TENANT_BASE_DOMAIN="localhost"
# Set to the canonical central app origin when using HTTPS or a reverse proxy.
# WORKSPACE_PUBLIC_ORIGIN="https://app.yourdomain.com"
# Optional override: online | onsite. Without this, subdomains choose online.
# EXA_DEPLOYMENT_MODE="online"
